# latent-diffusion/ and taming-transformers/ are vendored in tracked (their
# nested .git dirs were stripped so they commit as plain files, not gitlinks).
# CLIP/ stays untracked -- not needed for VAE training. Re-create with:
#   git clone https://github.com/openai/CLIP.git
/CLIP/

# Built by setup_env.sh (~4 GB)
/venv_ldm/
/venv_ldm.stale.*/

# Training output and weights (~16 GB)
/logs/
/models/
/recon_compare/
/setup_logs/

# Regenerate with scripts/make_filelists.py (absolute paths, machine-specific)
/filelists/

# Keep: vae_bench_results/*.json -- small, and the actual measurements
!/vae_bench_results/
# taming's get_ckpt_path writes vgg.pth to a cwd-relative path at runtime
/taming/

__pycache__/
*.egg-info/
